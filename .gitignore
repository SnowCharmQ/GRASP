# Training artefacts and data are far too large for git.
#   outputs/  106 GB of checkpoints (each Gemma ckpt is 18.5 GB)
#   data/     3.2 GB of built jsonl plus the raw LaMP-QA dump
# Both are reproducible from the scripts in this repo.
/outputs/
/data/
/logs/

# Model weights live outside the repo (18.5 GB Gemma, 15 GB Qwen).
*.safetensors
*.bin
*.pt
*.gguf

# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Editor / OS noise
.vscode/
.idea/
.DS_Store

# Local backups made while patching scripts in place
*.bak
*.bak[0-9]
*.orig

# Anything holding credentials
.env
*.token
